# SetPoint — variáveis de ambiente (copie para .env e ajuste)
# NUNCA versione o .env real.

PORT=3000

# Segurança (OBRIGATÓRIO trocar em produção)
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
ADMIN_USER=admin
ADMIN_PASS=defina-uma-senha-forte

# Banco de dados
# Padrão: arquivo JSON. Em produção, aponte para um disco persistente.
DB_PATH=/var/data/db.json

# (Futuro) Banco Postgres — quando migrarmos o db.js para SQL:
# DATABASE_URL=postgres://usuario:senha@host:5432/setpoint

# (Futuro) Pagamentos — Mercado Pago (módulo final)
# MP_ACCESS_TOKEN=
# MP_WEBHOOK_SECRET=
