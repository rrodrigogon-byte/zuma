# SetPoint — variáveis de ambiente (copie para .env e ajuste)
# NUNCA versione o .env real.

PORT=3000

# Segurança (OBRIGATÓRIO trocar em produção)
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
ADMIN_USER=admin
ADMIN_PASS=defina-uma-senha-forte
# Recuperação do admin: defina como 1 (com ADMIN_PASS acima) para redefinir a senha do
# admin no próximo boot — útil se a senha de produção for perdida. Remova depois.
# ADMIN_PASS_RESET=1

# Contas demo por papel (organizador/staff/atleta) para teste/handoff:
# SEED_DEMO=1
# DEMO_PASS=agroopen2026

# ── E-mail transacional (nominal) — Resend ───────────────────────────────
# Sem RESEND_API_KEY, os e-mails entram em modo simulado (log no console).
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# EMAIL_FROM=SetPoint <no-reply@seudominio.com.br>
# Dino: convites NÃO usam simulação; exigem Commerce ativo e remetente verificado no Resend.
# COMMERCE_CORE_ENABLED=1
# OPERATIONAL_INVITES_ENABLED=1
# O acesso empresarial só é criado quando o titular aceita o link e define sua senha.
# Contas criadas no painel legado não são vinculadas automaticamente ao Commerce.

# Banco de dados
# Padrão: arquivo JSON. Em produção, aponte para um disco persistente.
DB_PATH=/var/data/db.json

# (Futuro) Banco Postgres — quando migrarmos o db.js para SQL:
# DATABASE_URL=postgres://usuario:senha@host:5432/setpoint

# ── Pix ──────────────────────────────────────────────────────────────────
# Chave Pix estática (CNPJ, CPF, e-mail, telefone ou chave aleatória).
# Com PIX_CHAVE definida, o sistema gera BR Code EMV válido sem gateway externo.
# Deixe em branco para usar simulação local.
PIX_CHAVE=43084070000188
PIX_NOME=AGRO OPEN TTC
PIX_CIDADE=TANGARA DA SERRA

# (Opcional) Mercado Pago — substitui o Pix estático por cobranças dinâmicas com QR único por valor.
# MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx
# MP_WEBHOOK_SECRET=
# PLATFORM_FEE_PCT=5

# ── Clube & Academia (catraca, contrato digital, aulas, retenção, Wellhub/TotalPass) ──
# Só funciona com COMMERCE_CORE_ENABLED=1 (dados por empresa no PostgreSQL). Ver docs/CLUBE-ACADEMIA.md.
# Segredos com 32+ caracteres (openssl rand -base64 48). Não troque depois de usar.
# CLUBE_CONTRATO_SECRET=
# CLUBE_PARCEIROS_SECRET=
# CLUBE_QR_SECRET=
# PUBLIC_BASE_URL=https://seu-dominio.com.br
# CLUBE_ROTINAS=1          # lista de espera, lembretes, faltas, régua de retenção
# WELLHUB_API_TOKEN=
# WELLHUB_WEBHOOK_SECRET=
# TOTALPASS_PARTNER_API_KEY=
