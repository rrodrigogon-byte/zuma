# SetPoint — variáveis de ambiente (copie para .env e ajuste)
# NUNCA versione o .env real.

PORT=3000

# Segurança (OBRIGATÓRIO trocar em produção)
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
ADMIN_USER=admin
ADMIN_PASS=defina-uma-senha-forte

# Banco de dados
# Padrão: arquivo JSON. Em produção, aponte para um disco persistente.
DB_PATH=/var/data/db.json

# (Futuro) Banco Postgres — quando migrarmos o db.js para SQL:
# DATABASE_URL=postgres://usuario:senha@host:5432/setpoint

# ── Pix ──────────────────────────────────────────────────────────────────
# Chave Pix estática (CNPJ, CPF, e-mail, telefone ou chave aleatória).
# Com PIX_CHAVE definida, o sistema gera BR Code EMV válido sem gateway externo.
# Deixe em branco para usar simulação local.
PIX_CHAVE=43084070000188
PIX_NOME=AGRO OPEN TTC
PIX_CIDADE=TANGARA DA SERRA

# (Opcional) Mercado Pago — substitui o Pix estático por cobranças dinâmicas com QR único por valor.
# MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx
# MP_WEBHOOK_SECRET=
# PLATFORM_FEE_PCT=5
