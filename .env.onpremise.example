# ============================================================================
# KYTTO ERP ENTERPRISE - CONFIGURAÇÃO DE AMBIENTE ON-PREMISE / SOVEREIGN
# Copie este arquivo para .env no servidor local e configure as credenciais
# ============================================================================

# Modo de Operação (saas ou on-premise)
KYTTO_DEPLOYMENT_MODE=on-premise
NODE_ENV=production
HTTP_PORT=8080
APP_URL=http://localhost:8080

# Chave de Licença Soberana (Obtida junto à Kytto Authority)
# Formato: KYTTO-LIC.<payload_base64>.<hash_assinatura>
KYTTO_LICENSE_KEY=

# Segredo de Autenticação JWT do ERP
JWT_SECRET=substitua_por_uma_chave_aleatoria_longa_e_segura_de_64_caracteres_2026

# Banco de Dados PostgreSQL Interno (Docker)
POSTGRES_DB=kytto_enterprise
POSTGRES_USER=kytto_admin
POSTGRES_PASSWORD=defina_uma_senha_forte_para_o_banco_aqui_2026
POSTGRES_PORT=5432

# Cache & Filas Redis (Docker)
REDIS_PASSWORD=defina_uma_senha_forte_para_o_redis_aqui_2026
REDIS_PORT=6379

# WhatsApp Gateway Local (WAHA)
WAHA_PORT=3008

# Chave Opcional para Provedor de IA Externo (Gemini / OpenAI / Vertex)
# Se não configurado, o ERP opera com modelos heurísticos e estatísticos internos
GEMINI_API_KEY=
OPENAI_API_KEY=
