# Copie para .env somente na VM privada do Kytto. Nunca comite valores reais.
WAHA_WORKER_ID=kytto-waha
WAHA_PRINT_QR=false
WAHA_API_KEY=sha512:REPLACE_WITH_A_LONG_RANDOM_API_KEY
WAHA_DASHBOARD_ENABLED=false
WHATSAPP_SWAGGER_ENABLED=false
WAHA_EVENTS_DOWNLOAD_MEDIA=true
WAHA_EVENTS_DOWNLOAD_MEDIA_MIMETYPES=image,document,audio,video
WHATSAPP_FILES_FOLDER=/app/.sessions/files
WHATSAPP_FILES_LIFETIME=86400
WHATSAPP_API_KEY_EXCLUDE_PATH=ping,health
