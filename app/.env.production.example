# ─────────────────────────────────────────────────────────────────────────────
# SetPoint Ultra — Variáveis de Ambiente de PRODUÇÃO
# Copie este arquivo para .env.production e preencha os valores reais.
# NUNCA commite o arquivo .env.production no repositório.
# ─────────────────────────────────────────────────────────────────────────────

# ── Servidor ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080
APP_URL=https://app.setpointultra.com.br

# ── Banco de Dados (PostgreSQL — Cloud SQL) ───────────────────────────────────
# No Cloud Run, use o socket Unix do Cloud SQL Proxy:
DB_HOST=/cloudsql/SEU_PROJECT_ID:southamerica-east1:setpoint-db-prd
DB_USER=setpoint_admin
DB_PASSWORD=SENHA_FORTE_AQUI
DB_NAME=setpoint_ultra
DB_PORT=5432
DB_SSL=false

# ── Commerce Core ──────────────────────────────────────────────────────────────
# Deixe 0 até o PostgreSQL, tenant e migrations estarem homologados.
COMMERCE_CORE_ENABLED=0
COMMERCE_SCHEMA_ON_BOOT=1

# ── Segurança ─────────────────────────────────────────────────────────────────
JWT_SECRET=GERE_COM_openssl_rand_-base64_64
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=12

# ── Google Cloud Storage (para certificados A1, NFe XML, uploads) ─────────────
GCS_BUCKET=setpoint-ultra-storage
GCS_PROJECT_ID=SEU_PROJECT_ID
# Em Cloud Run, as credenciais são automáticas via Service Account.
# Para desenvolvimento local, aponte para o arquivo de credenciais:
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/para/credentials.json

# ── WhatsApp (Evolution API — self-hosted) ────────────────────────────────────
EVOLUTION_API_URL=https://evo.setpointultra.com.br
EVOLUTION_API_KEY=SUA_API_KEY_AQUI
EVOLUTION_INSTANCE=setpoint-prd

# ── Pagamentos ────────────────────────────────────────────────────────────────
# Stone TEF
STONE_CLIENT_ID=SEU_CLIENT_ID_STONE
STONE_CLIENT_SECRET=SEU_SECRET_STONE
STONE_ACCOUNT_ID=SEU_ACCOUNT_ID_STONE

# Mercado Pago
MP_ACCESS_TOKEN=SEU_ACCESS_TOKEN_MP
MP_PUBLIC_KEY=SUA_PUBLIC_KEY_MP

# PIX — Efí (Gerencianet)
EFI_CLIENT_ID=SEU_CLIENT_ID_EFI
EFI_CLIENT_SECRET=SEU_SECRET_EFI
EFI_PIX_KEY=SUA_CHAVE_PIX
# Caminho para o certificado mTLS do Efí (armazenado no GCS ou Secret Manager)
EFI_CERT_PATH=/app/certs/efi-cert.p12

# ── Fiscal (SEFAZ) ────────────────────────────────────────────────────────────
SEFAZ_AMBIENTE=producao
# Certificado A1 é armazenado criptografado no banco por tenant.
# A senha de decriptação fica no Secret Manager:
CERT_ENCRYPTION_KEY=GERE_COM_openssl_rand_-hex_32

# ── Expo Push Notifications ───────────────────────────────────────────────────
EXPO_ACCESS_TOKEN=SEU_TOKEN_EXPO

# ── E-mail (para envio de holeites, boletos, etc.) ───────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@setpointultra.com.br
SMTP_PASS=SENHA_APP_GMAIL

# ── Billing SaaS (Assinaturas) ────────────────────────────────────────────────
BILLING_WEBHOOK_SECRET=GERE_COM_openssl_rand_-hex_32

# ── Logs e Monitoramento ──────────────────────────────────────────────────────
LOG_LEVEL=info
# Cloud Run envia logs automaticamente para o Cloud Logging.
