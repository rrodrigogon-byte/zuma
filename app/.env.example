# Copie para ".env" e ajuste. Sem estas variáveis o app roda em modo local com snapshot.
PORT=3000
JWT_SECRET=troque-por-uma-chave-secreta-forte
ADMIN_USER=admin
ADMIN_PASS=agroopen2026

# Persistência durável no Cloud Run (disco efêmero). Bucket GCS para replicar o
# db.json. Vazio = só disco local (dev/Render com disco). Requer max-instances=1.
GCS_BUCKET=
# GCS_OBJECT=db.json

# CORS: origens permitidas (separadas por vírgula) para chamadas cross-origin.
# Vazio = sem CORS (API e SPA no mesmo host). Nunca use "*" com credenciais.
CORS_ORIGINS=

# Ranking ATP/WTA ao vivo (ex.: RapidAPI). Sem isto, usa o snapshot em data/.
# RAPIDAPI_HOST e KEY de um provedor de dados de tênis:
RAPIDAPI_TENNIS_HOST=
RAPIDAPI_KEY=

# Notícias ao vivo (newsapi.org). Sem isto, usa o snapshot em data/.
NEWSAPI_KEY=
