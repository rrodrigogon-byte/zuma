{
  "name": "setpoint",
  "version": "4.5.0",
  "description": "SetPoint — plataforma de gestão esportiva e de arenas (torneios, chaves, ranking, ingressos+QR, PDV, reserva de quadras, patrocínio, carteira). Evento de demonstração: 4ª Agro Open de Tênis.",
  "type": "module",
  "main": "server-erp.js",
  "scripts": {
    "start": "node server-erp.js",
    "dev": "node --watch server-erp.js",
    "commerce:schema:dry-run": "node migrations/run-commerce-schema-migrations.js --dry-run",
    "commerce:schema:apply": "node migrations/run-commerce-schema-migrations.js && node migrations/run-prd-cutover.js",
    "avec:import:dry-run": "node migrations/run-avec-dino-import.js --dry-run",
    "avec:import:apply": "node migrations/run-avec-dino-import.js",
    "dino:recalc:dry-run": "node migrations/run-dino-recalc.js --dry-run",
    "dino:recalc:apply": "node migrations/run-dino-recalc.js",
    "commerce:import:dry-run": "node migrations/import-legacy-commerce.js",
    "commerce:import:apply": "node migrations/import-legacy-commerce.js --apply"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.0.1",
    "@xmldom/xmldom": "^0.9.12",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "bwip-js": "^4.11.2",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "ejs": "^6.0.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.1",
    "node-forge": "^1.4.0",
    "pg": "^8.11.0",
    "qr-image": "^3.2.0",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xml-crypto": "^6.3.2",
    "xml2js": "^0.6.2",
    "xmllint-wasm": "^5.3.0"
  },
  "overrides": {
    "uuid": "11.1.1",
    "qs": "6.16.0"
  }
}
