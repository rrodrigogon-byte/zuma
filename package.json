{
  "name": "erp-modular-brasil",
  "version": "2.0.0",
  "description": "ERP Modular para Bares, Restaurantes, Clubes, Lojas e Comércio em Geral",
  "type": "module",
  "main": "app/server-v2.js",
  "scripts": {
    "start": "node app/server-v2.js",
    "dev": "nodemon app/server-v2.js",
    "migrate": "node app/migrations/migrate-json-to-pg.js",
    "migrate:sql": "node app/migrations/run-sql-migrations.js",
    "worker:omnichannel": "node app/workers/omnichannel-worker.js --once",
    "check:omnichannel-worker": "node --check app/workers/omnichannel-worker.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "jest --testPathPattern=e2e",
    "lint": "eslint app/",
    "format": "prettier --write app/",
    "docker:build": "docker build -t erp-modular:latest .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "keywords": [
    "erp",
    "brasil",
    "nfce",
    "pdv",
    "pagamentos",
    "estoque",
    "bar",
    "restaurante",
    "loja"
  ],
  "author": "Manus AI",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.3",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "dotenv": "^16.3.1",
    "axios": "^1.6.0",
    "uuid": "^9.0.1",
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.52.0",
    "prettier": "^3.0.3",
    "@babel/preset-env": "^7.23.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
